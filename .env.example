# =============================================================================
# TrendAI Demo Platform — environment template
# Copy to `.env` and adjust. `.env` is gitignored.
#
#   cp .env.example .env
#   docker compose up -d --build
# =============================================================================

# --- Portal -----------------------------------------------------------------
# The portal always seeds admin / admin on first boot and forces a password
# change. It reverse-proxies every demo behind that login, so nothing else here
# is required. To change the published port, edit docker-compose.yml
# (portal.ports).

# --- Smish Detector ---------------------------------------------------------
# Password required to view the captured-data report page.
REPORT_PASSWORD=sms

# --- V1 File Security Scanner ------------------------------------------------
# The Vision One File Security API key + region are entered in the tool's own
# Settings UI at runtime (persisted in its Docker volume). Nothing needed here.

# --- AI Guard & File Security (chatbot) + Ollama -----------------------------
# A bundled Ollama container serves a small CPU model for the chatbot and is
# pre-wired at http://ollama:11434. Change the model here (pulled on first
# start). llama3.2:1b is faster on CPU; gemma2:2b is the default.
OLLAMA_MODEL=gemma2:2b
# TrendAI Vision One API keys for the two detection modules are entered in the
# app's Settings UI at runtime (no secrets in files).

# --- AI Target Range (vulnerable AI apps for red-team testing) --------------
# The target app is published on the host WITHOUT login so tools like Vantyr
# can attack it. Lab networks only. Bind to one interface if the host has several.
AI_TARGET_PORT=8090
AI_TARGET_BIND=0.0.0.0
# Address the red-team tool will use (shown in the control panel's scope JSON).
# AI_TARGET_PUBLIC_URL=http://192.168.1.20:8090
# LLM: bundled Ollama by default. Needs a tool-calling model. For vLLM use the
# server's /v1 URL, e.g. http://vllm-host:8000/v1, and the served model name.
AI_TARGET_LLM_PROVIDER=ollama
AI_TARGET_LLM_URL=http://ollama:11434
AI_TARGET_MODEL=qwen2.5:3b
# AI_TARGET_LLM_API_KEY=
# TrendAI Vision One protection for the AI Target Range. Optional: keys can also
# be entered in the control panel (kept in memory only). A key set here turns
# that engine on at start-up.
# V1_AI_GUARD_API_KEY=
# V1_AI_GUARD_REGION=us          # us | eu | jp | sg | au | in | mea
# V1FS_API_KEY=
# V1FS_REGION=us-east-1
